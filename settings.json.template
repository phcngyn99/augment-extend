{
  "indexingAllowDirs": [
  ],
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "codegraph": {
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp"
      ]
    },
    "agent-browser": {
      "command": "agent-browser",
      "args": [
        "mcp",
        "--tools",
        "all"
      ]
    }
  },
  "notificationMode": "bell",
  "startupScript": "~/.augment/startup/show-workspace.sh",
  "autoUpdateMarketplaces": true,
  "theme": "default-dark",
  "toolPermissions": [
    { "toolName": "codebase-retrieval", "permission": { "type": "deny" } }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.augment/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "launch-process",
        "hooks": [
          {
            "type": "command",
            "command": "~/.augment/hooks/dcg-pre-shell.py",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "verbose": false,
  "model": "glm-5.2"
}