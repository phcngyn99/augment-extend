{
  "indexingAllowDirs": [""],
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "codegraph": {
      "command": "npx",
      "args": ["-y", "@colbymchenry/codegraph", "serve", "--mcp"],
      "env": {
        "CODEGRAPH_MCP_TOOLS": "explore,node,search,callers,callees,impact,files,status"
      }
    },
    "agent-browser": {
      "command": "agent-browser",
      "args": ["mcp", "--tools", "all"]
    }
  },
  "notificationMode": "desktop_notification",
  "startupScript": "~/.augment/startup/update-submodules.sh --dry-run",
  "autoUpdateMarketplaces": true,
  "theme": "default-dark",
  "toolPermissions": [
    { "toolName": "codebase-retrieval", "permission": { "type": "deny" } },
    { "toolName": "grep-search", "permission": { "type": "deny" } }
  ],
  "verbose": false
}