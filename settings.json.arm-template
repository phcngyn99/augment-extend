{
  "indexingAllowDirs": [
  ],
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "@upstash/context7-mcp"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "agent-browser": {
      "command": "agent-browser",
      "args": [
        "mcp",
        "--tools",
        "all"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp",
        "--headless",
        "--no-sandbox",
        "--ignore-https-errors",
        "--executable-path",
        "/home/<USER>/.cache/ms-playwright/chromium-1228/chrome-linux/chrome"
      ]
    }
  },
  "notificationMode": "bell",
  "startupScript": "~/.augment/scripts/show-workspace.sh",
  "autoUpdateMarketplaces": true,
  "theme": "default-dark",
  "toolPermissions": [
    { "toolName": "codebase-retrieval", "permission": { "type": "deny" } },
    { "toolName": "grep-search", "permission": { "type": "deny" } },
    { "toolName": "web-fetch", "permission": { "type": "deny" } }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.augment/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "launch-process",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /home/wanek3/.augment/hooks/dcg-pre-shell.py",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "verbose": false,
  "model": "glm-5.2"
}